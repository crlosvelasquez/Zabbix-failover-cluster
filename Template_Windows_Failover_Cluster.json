{
    "zabbix_export": {
        "version": "6.0",
        "date": "2026-06-01T12:00:00Z",
        "groups": [
            {
                "uuid": "5e4299f40ebd4b4191d2ef7a2eefab00",
                "name": "Templates"
            }
        ],
        "templates": [
            {
                "uuid": "1d840f41d4f246488092b5bc8bf3b649",
                "template": "Template Windows Failover Cluster",
                "name": "Template Windows Failover Cluster",
                "description": "This template provides basic and comprehensive monitoring for Windows High Availability Clusters (Windows Failover Cluster). It uses PowerShell scripts through the Zabbix agent to auto-discover and evaluate the state of cluster nodes, core resources, virtual machines, their configurations, and network adapters. It generates automatic alerts if any critical component or node loses its expected operational state (Online/Up).",
                "groups": [
                    {
                        "name": "Templates"
                    }
                ],
                "discovery_rules": [
                    {
                        "uuid": "d793a193cdff4d4b946c0b36f5eb33b6",
                        "name": "Failover Cluster - Discovery - Nodes",
                        "type": "ZABBIX_ACTIVE",
                        "key": "cluster.nodes.discovery",
                        "delay": "1h",
                        "item_prototypes": [
                            {
                                "uuid": "2c1c487298064a39a3be9d46af5284a9",
                                "name": "Failover Cluster - Node State: {#NAME}",
                                "type": "ZABBIX_ACTIVE",
                                "key": "cluster.node.state[{#ID}]",
                                "trends": "0",
                                "value_type": "TEXT",
                                "tags": [
                                    {
                                        "tag": "Application",
                                        "value": "Failover Cluster"
                                    },
                                    {
                                        "tag": "Component",
                                        "value": "Nodes"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "836e79b7e43a428d89ebbc82836318e3",
                                        "expression": "last(/Template Windows Failover Cluster/cluster.node.state[{#ID}])<>\"Up\"",
                                        "name": "Failover Cluster node \"{#NAME}\" is not online",
                                        "priority": "DISASTER"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "8de87c0c95bd43f0948ec8719645c05e",
                        "name": "Failover Cluster - Discovery - Core Resources",
                        "type": "ZABBIX_ACTIVE",
                        "key": "cluster.resources.discovery[core]",
                        "delay": "1h",
                        "filter": {
                            "evaltype": "OR",
                            "conditions": [
                                {
                                    "macro": "{#TYPE}",
                                    "value": "^Virtual Machine Configuration|^Virtual Machine",
                                    "operator": "NOT_MATCHES_REGEX",
                                    "formulaid": "A"
                                }
                            ]
                        },
                        "item_prototypes": [
                            {
                                "uuid": "674271b84b4c4ecebf2ad7e4b0572049",
                                "name": "Failover Cluster - Core Resource State: {#NAME}",
                                "type": "ZABBIX_ACTIVE",
                                "key": "cluster.resource.state[{#ID}]",
                                "trends": "0",
                                "value_type": "TEXT",
                                "tags": [
                                    {
                                        "tag": "Application",
                                        "value": "Failover Cluster"
                                    },
                                    {
                                        "tag": "Component",
                                        "value": "Core Resources"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "7244bdb782a64da7a9243d210d1ab00e",
                                        "expression": "last(/Template Windows Failover Cluster/cluster.resource.state[{#ID}])<>\"Online\"",
                                        "name": "Failover Cluster core resource \"{#NAME}\" is not online",
                                        "priority": "DISASTER",
                                        "description": "Trigger when a core cluster resource is not in the \"Online\" state."
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "20257191dab94570b9937f0444365a8f",
                        "name": "Failover Cluster - Discovery - VM Configurations",
                        "type": "ZABBIX_ACTIVE",
                        "key": "cluster.resources.discovery[vmconfig]",
                        "status": "DISABLED",
                        "filter": {
                            "evaltype": "AND",
                            "conditions": [
                                {
                                    "macro": "{#TYPE}",
                                    "value": "^Virtual Machine Configuration",
                                    "formulaid": "A"
                                }
                            ]
                        },
                        "item_prototypes": [
                            {
                                "uuid": "253f3e9eea774c3a81cfa5f14c30fca7",
                                "name": "Failover Cluster - VM Config State: {#NAME}",
                                "type": "ZABBIX_ACTIVE",
                                "key": "cluster.resource.state[{#ID},vmconfig]",
                                "trends": "0",
                                "value_type": "TEXT",
                                "tags": [
                                    {
                                        "tag": "Application",
                                        "value": "Failover Cluster"
                                    },
                                    {
                                        "tag": "Component",
                                        "value": "VM Configurations"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "ffdd48fe6da4415ba0ec278bc8c628df",
                                        "expression": "last(/Template Windows Failover Cluster/cluster.resource.state[{#ID},vmconfig])<>\"Online\"",
                                        "name": "Failover Cluster \"{#NAME}\" is not online",
                                        "priority": "DISASTER"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "9b3eb6f38dea44feb19fc642ae787aa4",
                        "name": "Failover Cluster - Discovery - Virtual Machines",
                        "type": "ZABBIX_ACTIVE",
                        "key": "cluster.resources.discovery[vm]",
                        "filter": {
                            "evaltype": "AND",
                            "conditions": [
                                {
                                    "macro": "{#TYPE}",
                                    "value": "^Virtual Machine",
                                    "formulaid": "A"
                                },
                                {
                                    "macro": "{#TYPE}",
                                    "value": "^Virtual Machine Configuration",
                                    "operator": "NOT_MATCHES_REGEX",
                                    "formulaid": "B"
                                }
                            ]
                        },
                        "item_prototypes": [
                            {
                                "uuid": "12d6b58b9b5e46479f0f0493220a468c",
                                "name": "Failover Cluster - VM State: {#NAME}",
                                "type": "ZABBIX_ACTIVE",
                                "key": "cluster.resource.state[{#ID},vm]",
                                "trends": "0",
                                "value_type": "TEXT",
                                "tags": [
                                    {
                                        "tag": "Application",
                                        "value": "Failover Cluster"
                                    },
                                    {
                                        "tag": "Component",
                                        "value": "Virtual Machines"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "7f765b5cc20e427b8e974bb694106a53",
                                        "expression": "last(/Template Windows Failover Cluster/cluster.resource.state[{#ID},vm])<>\"Online\"",
                                        "name": "Failover Cluster \"{#NAME}\" is not online",
                                        "priority": "DISASTER"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "7e1e9070bb184516a9561e228d21671f",
                        "name": "Failover Cluster - Discovery - VM Network Adapters",
                        "type": "ZABBIX_ACTIVE",
                        "key": "cluster.vm.network.adapter.discovery",
                        "delay": "1h",
                        "status": "DISABLED",
                        "item_prototypes": [
                            {
                                "uuid": "31c1a3f04f4c41e29f7411174ff390e4",
                                "name": "Failover Cluster - VM Network Adapter: {#VMNAME} {#NAME}",
                                "type": "ZABBIX_ACTIVE",
                                "key": "cluster.vm.network.adapter.type[{#VMNAME}, {#ID}]",
                                "trends": "0",
                                "value_type": "TEXT",
                                "tags": [
                                    {
                                        "tag": "Application",
                                        "value": "Failover Cluster"
                                    },
                                    {
                                        "tag": "Component",
                                        "value": "Network"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "2ad9a9b9113a4a5f9898c60894c64679",
                                        "expression": "last(/Template Windows Failover Cluster/cluster.vm.network.adapter.type[{#VMNAME}, {#ID}])<>\"Static\"",
                                        "name": "VM Network Adapter on #VMNAME is not static (#NAME)",
                                        "priority": "WARNING"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}